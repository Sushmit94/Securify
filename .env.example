# LLM reasoning layer (Layer 3) -- set at least one. Anthropic is preferred when both are set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional overrides
LLM_MODEL=claude-sonnet-5
LLM_MODEL_OPENAI=gpt-4o

# Scan history storage. Defaults to a local SQLite file if unset.
# For Postgres (per the README's tech stack): postgresql+psycopg2://user:password@localhost:5432/securify
DATABASE_URL=

# Frontend dev server proxies /scan, /report, /history to this backend URL.
BACKEND_URL=http://localhost:8000
